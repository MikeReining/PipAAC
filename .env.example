# Shift local environment — TEMPLATE.
#
# Copy to .env and fill in real values. NEVER put real secrets in this file:
# .env.example is committed, .env is gitignored.
#
#   cp .env.example .env
#
# Nothing in the repo reads these automatically — scripts resolve them from the
# process environment. To load .env into your shell:
#
#   set -a && source .env && set +a

# Image generation (scripts/art/gen.mjs)
OPENROUTER_API_KEY=

# Speech / audio generation (ElevenLabs)
ELEVENLABS_API_KEY=
# House narrator clone — same id as WorkbookBench catalog TTS (not a secret)
ELEVENLABS_VOICE_ID=WWMMC6k9tdar0BthUenK

# WorkbookBench clone — catalog audio import reads manifest + lookup from here
WORKBOOKBENCH_ROOT=

# 028 — tile-voice review page (npm run tilevoice:review →
# http://127.0.0.1:3747/audio-review/tile-voice). The page proxies the
# Worker's /admin/v1/tile-voice/* routes; the token never reaches the
# browser. PIP_TILE_ADMIN_URL points at the dev Worker or the deployed one.
PIP_ADMIN_TOKEN=
PIP_TILE_ADMIN_URL=http://127.0.0.1:21088
