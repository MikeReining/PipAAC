{
  "name": "pippaac",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "test": "scripts/test.sh --all",
    "check": "node scripts/check.mjs",
    "check:fast": "node scripts/check_fast.mjs",
    "lint:phase-freshness": "node scripts/check_phase_doc_freshness.mjs",
    "lint:lockfile-sync": "node scripts/check_lockfile_sync.mjs",
    "bootstrap:env": "node scripts/bootstrap_local_env.mjs",
    "dev": "node scripts/dev.mjs browse",
    "dev:agent": "node scripts/dev.mjs auto",
    "dev:status": "node scripts/dev.mjs status",
    "dev:site": "wrangler dev --config site/wrangler.jsonc --port 21200",
    "deploy:site": "wrangler deploy --config site/wrangler.jsonc",
    "site:compare": "node scripts/site/build_compare.mjs",
    "catalog:lexicon": "node scripts/catalog/extract_launch_lexicon.mjs",
    "catalog:lexicon:check": "node scripts/catalog/extract_launch_lexicon.mjs --check",
    "catalog:build": "node scripts/catalog/build_catalog.mjs",
    "catalog:build:check": "node scripts/catalog/build_catalog.mjs --check",
    "catalog:art:gaps": "node scripts/art/art_gaps.mjs",
    "catalog:art:gaps:extended": "node scripts/art/art_gaps.mjs --extended",
    "catalog:art:gaps:groups": "node scripts/art/art_gaps.mjs --walk groups --limit 10",
    "art:review": "node scripts/art/review_lane.mjs",
    "art:publish-reviewed": "node scripts/art/publish_reviewed_art.mjs",
    "catalog:audio:coverage": "node scripts/catalog/coverage.mjs",
    "catalog:audio:elevenlabs-inventory": "node scripts/catalog/list_elevenlabs_catalog_audio.mjs",
    "catalog:v4-lab:mint-batch": "node scripts/catalog/mint_v4_lab_batch.mjs",
    "catalog:v4-lab:publish": "node scripts/catalog/publish_v4_lab_approved.mjs",
    "catalog:voice-selector:mint": "node scripts/catalog/mint_voice_selector_round.mjs",
    "catalog:expressive-probe:mint": "node scripts/catalog/elevenlabs_expressive_probe.mjs",
    "catalog:audio:import": "node scripts/catalog/import_wbb_audio.mjs",
    "catalog:audio:materialize": "node scripts/catalog/materialize_audio.mjs",
    "catalog:audio:inspect": "node scripts/catalog/audio_inspect.mjs",
    "catalog:audio:explore": "node scripts/catalog/explore_grok_batch.mjs",
    "catalog:audio:mint-backup": "node scripts/catalog/mint_backup_voice.mjs",
    "catalog:audio:review": "node scripts/catalog/audio_review_dev.mjs",
    "tilevoice:review": "node scripts/catalog/audio_review_dev.mjs",
    "tilevoice:reconcile": "node scripts/catalog/tilevoice_reconcile.mjs",
    "tilevoice:seed-catalog": "node scripts/catalog/tilevoice_seed_catalog.mjs",
    "catalog:tiles:queue": "node scripts/catalog/build_elevenlabs_tile_queue.mjs",
    "catalog:tiles:mint": "node scripts/catalog/mint_elevenlabs_tile.mjs",
    "catalog:tiles:mint-batch": "node scripts/catalog/build_elevenlabs_tile_queue.mjs && node scripts/catalog/mint_elevenlabs_tile_batch.mjs",
    "catalog:tiles:mint-gaps": "node scripts/catalog/mint_launch_audio_gaps.mjs",
    "catalog:tiles:mint-leo-seed": "node scripts/catalog/mint_tile_voice_seed.mjs",
    "catalog:tiles:publish-shortlist": "node scripts/catalog/publish_elevenlabs_shortlist.mjs",
    "catalog:forms:queue": "node scripts/catalog/build_elevenlabs_forms_queue.mjs",
    "catalog:forms:mint-batch": "node scripts/catalog/build_elevenlabs_forms_queue.mjs && node scripts/catalog/mint_elevenlabs_tile_batch.mjs --batch elevenlabs-forms-core",
    "catalog:forms:publish-shortlist": "node scripts/catalog/publish_elevenlabs_forms_shortlist.mjs",
    "pictures:add": "node scripts/pictures/add_drawing.mjs",
    "pictures:index": "node scripts/pictures/build_index.mjs --upsert",
    "pictures:index:calib": "node scripts/pictures/build_index.mjs --calibration --upsert",
    "pictures:calibrate": "node scripts/pictures/calibration_dev.mjs",
    "pictures:lab": "node scripts/pictures/calibration_dev.mjs",
    "prediction:bench": "node scripts/prediction/bench/bench.mjs",
    "prediction:book": "node scripts/prediction/book/build_book.mjs && node scripts/prediction/book/score_book.mjs",
    "seo:collect": "node scripts/seo/collect.mjs"
  },
  "devDependencies": {
    "linkedom": "0.18.13",
    "playwright-core": "1.63.0",
    "sharp": "0.35.4",
    "typescript": "5.7.3",
    "wrangler": "^4.45.0"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.4-build1",
    "qrcode-generator": "2.0.4"
  }
}
