{
  "name": "pippaac",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <27"
  },
  "scripts": {
    "test": "scripts/test.sh --all",
    "check": "node scripts/check.mjs",
    "check:fast": "node scripts/check_fast.mjs",
    "lint:phase-freshness": "node scripts/check_phase_doc_freshness.mjs",
    "lint:lockfile-sync": "node scripts/check_lockfile_sync.mjs",
    "bootstrap:env": "node scripts/bootstrap_local_env.mjs",
    "dev": "node scripts/dev.mjs browse",
    "dev:agent": "node scripts/dev.mjs auto",
    "dev:status": "node scripts/dev.mjs status",
    "catalog:lexicon": "node scripts/catalog/extract_launch_lexicon.mjs",
    "catalog:lexicon:check": "node scripts/catalog/extract_launch_lexicon.mjs --check",
    "catalog:build": "node scripts/catalog/build_catalog.mjs",
    "catalog:build:check": "node scripts/catalog/build_catalog.mjs --check",
    "catalog:audio:coverage": "node scripts/catalog/coverage.mjs",
    "catalog:audio:import": "node scripts/catalog/import_wbb_audio.mjs",
    "catalog:audio:materialize": "node scripts/catalog/materialize_audio.mjs",
    "catalog:audio:inspect": "node scripts/catalog/audio_inspect.mjs",
    "catalog:audio:explore": "node scripts/catalog/explore_grok_batch.mjs",
    "prediction:bench": "node scripts/prediction/bench/bench.mjs",
    "prediction:book": "node scripts/prediction/book/build_book.mjs && node scripts/prediction/book/score_book.mjs"
  },
  "devDependencies": {
    "sharp": "0.35.4",
    "wrangler": "^4.45.0"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.4-build1",
    "qrcode-generator": "2.0.4"
  }
}
