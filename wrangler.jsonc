{
  "name": "pippaac",
  "main": "src/worker/index.js",
  "compatibility_date": "2026-09-21",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ENVIRONMENT": "production",
    "TILE_DAY_MINTS": "500"
  },
  "durable_objects": {
    "bindings": [
      { "name": "RELAY", "class_name": "UserRelay" },
      { "name": "PAIR", "class_name": "PairingLobby" },
      { "name": "ACCOUNTS", "class_name": "SupporterAccounts" },
      { "name": "TILE_LEDGER", "class_name": "TileLedger" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BoardRelay"] },
    { "tag": "v2", "new_sqlite_classes": ["PairingLobby"] },
    { "tag": "v3", "renamed_classes": [{ "from": "BoardRelay", "to": "UserRelay" }] },
    { "tag": "v4", "new_sqlite_classes": ["SupporterAccounts"] },
    { "tag": "v5", "new_sqlite_classes": ["TileLedger"] }
  ],
  "ai": { "binding": "AI", "remote": true },
  "vectorize": [
    { "binding": "PICTURES", "index_name": "pip-pictures", "remote": true },
    { "binding": "PICTURES_CALIB", "index_name": "pip-pictures-calibration", "remote": true }
  ],
  "r2_buckets": [
    { "binding": "BLOBS", "bucket_name": "pippaac-sync" },
    { "binding": "VOICE", "bucket_name": "pippaac-voice" },
    { "binding": "EXT_ART", "bucket_name": "workbookbench-catalog" }
  ],
  "analytics_engine_datasets": [
    { "binding": "RESEARCH", "dataset": "pip_research" }
  ]
}
