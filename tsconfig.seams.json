{
  "//": "043 J — checkJs on the platform seams only. The iOS boundary",
  "//2": "carries types; the app stays plain JS. check:fast gate: types:seams.",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "target": "ES2022",
