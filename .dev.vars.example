# wrangler dev secrets. Copy to .dev.vars and fill in. Never commit .dev.vars.
#
# Required for local dev: wrangler.jsonc ships ENVIRONMENT=production so
# deploys never expose dev routes; .dev.vars overrides it back locally.
ENVIRONMENT=development
#
#   cp .dev.vars.example .dev.vars
#
# Production (once, per environment):
#   npx wrangler secret put <SECRET_NAME>
# 006 slice 5 — Jev reranker: Worker-side TypeSafe key (never on the device).
TYPESAFE_API_KEY=
# 011 slice 9 — Pip Lifetime license minting (dev path; any random string).
PIP_LICENSE_SECRET=
# 015 slice 7 — worker-internal calls (account-deletion cascade to user
# relays). Optional: falls back to PIP_LICENSE_SECRET when unset.
PIP_INTERNAL_SECRET=
# 023 — transform buttons (fix/question/tense): Worker-side Groq key.
# Without it POST /api/v1/transform returns 503 transform_unavailable.
GROQ_API_KEY=
# 024/025 — whole-sentence voice (neutral + feelings): Eleven v4, same
# voice_key as tiles. Without ELEVENLABS_API_KEY, POST /api/v1/voice/speak
# returns 503 voice_unavailable.
# Legacy Grok explore scripts only (not sentence playback):
XAI_API_KEY=
# 028 — tile voice library. Real ElevenLabs tile mints need BOTH: the key
# and TILE_LIVE=1. Without them POST /api/v1/voice/tile mints a short
# silent stub clip — dev servers never spend money by accident.
# Sentence speak uses the key only (no TILE_LIVE).
ELEVENLABS_API_KEY=
TILE_LIVE=
# Founder-only /admin/v1/tile-voice/* and /admin/v1/license-codes routes
# (Bearer token).
PIP_ADMIN_TOKEN=
# 015 slice 6 — Stripe Checkout + webhook (web purchases of Pip
# Lifetime). STRIPE_PRICE_ID is the $49 Price created in the Stripe
# dashboard; STRIPE_WEBHOOK_SECRET is the endpoint's signing secret.
# Without these, /api/v1/checkout and /api/v1/stripe/webhook return 503
# payments_unavailable — license codes and dev licenses still work.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
