# wrangler dev secrets. Copy to .dev.vars and fill in. Never commit .dev.vars.
#
#   cp .dev.vars.example .dev.vars
#
# Production (once, per environment):
#   npx wrangler secret put <SECRET_NAME>
# 006 slice 5 — Jev reranker: Worker-side TypeSafe key (never on the device).
TYPESAFE_API_KEY=
# 011 slice 9 — Pip Lifetime license minting (dev path; any random string).
PIP_LICENSE_SECRET=
# 015 slice 7 — worker-internal calls (account-deletion cascade to user
# relays). Optional: falls back to PIP_LICENSE_SECRET when unset.
PIP_INTERNAL_SECRET=
# 023 — transform buttons (fix/question/tense): Worker-side Groq key.
# Without it POST /api/v1/transform returns 503 transform_unavailable.
GROQ_API_KEY=
# 024 — whole-sentence voice: Worker-side xAI Grok TTS key.
# Without it POST /api/v1/voice/speak returns 503 voice_unavailable.
XAI_API_KEY=
